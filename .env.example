# Formspree form IDs (public — they end up in the browser bundle). Create forms at https://formspree.io
# You can use the same ID for all three if you prefer a single inbox.
# When an ID is empty the form falls back to opening the visitor's email app (mailto:),
# and the UI says clearly that the message has NOT been sent yet.
VITE_FORMSPREE_CONTACT_ID=
VITE_FORMSPREE_INVESTOR_ID=
VITE_FORMSPREE_PARTNER_ID=

# NEVER put secrets in VITE_* variables: everything prefixed VITE_ is shipped to every visitor.
# Stripe secret keys (sk_live / sk_test), webhook secrets (whsec_) and API tokens belong
# only in a server-side backend, never in this frontend repository.
